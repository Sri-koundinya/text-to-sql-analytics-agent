# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env

# --- PostgreSQL admin (used only by the db container to create the schema) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-admin-password
# Host port for the database (bound to 127.0.0.1 only)
DB_PORT=5432

# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# --- Query guardrails (see backend/app/config.py for allowed ranges) ---
MAX_RESULT_ROWS=200
QUERY_TIMEOUT_MS=8000
MAX_SQL_RETRIES=2
RATE_LIMIT_PER_MINUTE=20

# --- Misc ---
LOG_LEVEL=INFO
# Exposes raw error messages in API responses. Keep false outside local debugging.
DEBUG=false
CORS_ORIGINS=

# --- Only for running the backend outside Docker (uvicorn from backend/) ---
# The app always connects as the read-only analytics_reader role, never the admin user.
# DATABASE_URL=postgresql+psycopg://analytics_reader:analytics_reader@localhost:5432/retail_analytics
